void main() {
  // String
  String name = "Anusha";

  // Boolean
  bool male = true;

  // Integer
  int age = 21;

  // List
  List<String> fruits = ["mango", "apple"];

  // Map
  Map<String, dynamic> myData = {
    "name": name,
    "age": age,
    "male": male,
    "fruits": fruits,
  };

  // Add multiple fruits
  fruits.addAll(["banana", "guava", "grapes"]);

  // Sort fruits alphabetically
  fruits.sort();

  // Check if grapes exists
  bool val = fruits.contains("grapes");

  // Find banana
  var result = fruits.where((element) => element == "banana");

  // Print Map
  print(myData);

  // Get age from Map
  print(myData["age"]);

  // Get all keys
  print(myData.keys.toList());

  // Get all values
  print(myData.values.toList());

  // Check if a key exists
  print(myData.containsKey("name"));

  // Print filtered result
  print(result.toList());
}
